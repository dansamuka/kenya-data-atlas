    {"indicator_id":"IND-HOUSEHOLD-SIZE","treatment_class":"census_or_household_crosswalk"},
    {"indicator_id":"IND-HOUSEHOLDS-CASH-TRANSFER-SOCIAL-ASSISTANCE","treatment_class":"survey_small_area"},
    {"indicator_id":"IND-HOUSING-MATERIAL","treatment_class":"census_or_household_crosswalk"},
    {"indicator_id":"IND-HOUSING-OWNER-OCCUPIED","treatment_class":"survey_small_area"},
    {"indicator_id":"IND-IMMUNIZATION-RATE","treatment_class":"survey_small_area"},
    {"indicator_id":"IND-INPATIENT-SERVICE-AVAILABILITY","treatment_class":"facility_service_rate"},
    {"indicator_id":"IND-INTERNET-USE","treatment_class":"survey_small_area"},
    {"indicator_id":"IND-LABOUR-FORCE-PARTICIPATION","treatment_class":"survey_small_area"},
    {"indicator_id":"IND-LAND-AREA","treatment_class":"geometry_derived"},
    {"indicator_id":"IND-LITERACY-RATE","treatment_class":"survey_small_area"},
    {"indicator_id":"IND-MAIN-GRID-ELECTRICITY","treatment_class":"survey_small_area","semantic_relationship":{"type":"alias_review","related_indicator":"IND-ELECTRICITY-ACCESS"}},
    {"indicator_id":"IND-MAIZE-AREA","treatment_class":"agriculture_local"},
    {"indicator_id":"IND-MAIZE-PRODUCTION","treatment_class":"agriculture_local"},
    {"indicator_id":"IND-MAIZE-YIELD","treatment_class":"agriculture_local"},
    {"indicator_id":"IND-MANUFACTURING-GCP-SHARE","treatment_class":"economic_accounts_small_area"},
    {"indicator_id":"IND-MANUFACTURING-GVA","treatment_class":"economic_accounts_small_area"},
    {"indicator_id":"IND-MATERNAL-HEALTH","treatment_class":"survey_small_area"},
