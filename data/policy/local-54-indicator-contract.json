  ],
  "acceptance": {
    "indicator_count": 54,
    "all_indicator_ids_must_exist_in_manifest": true,
    "all_indicator_ids_must_exist_in_canonical_registry": true,
    "all_indicator_ids_must_have_treatment_class": true,
    "all_treatment_classes_must_resolve": true,
    "all_definitions_units_periods_bound_to_canonical_registry": true,
    "secondary_source_rule_applies_to_existing_and_new_data": true,
    "legacy_unavailable_states_require_P28A_reaudit": true,
    "parent_child_inheritance_prohibited": true
  }
