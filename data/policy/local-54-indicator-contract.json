    {"indicator_id":"IND-CONTRACEPTIVE-USE","treatment_class":"survey_small_area"},
    {"indicator_id":"IND-COUNTY-AUDIT-OPINION","treatment_class":"institutional_county_only","constituency_default":"not_applicable","ward_default":"not_applicable"},
    {"indicator_id":"IND-COUNTY-BUDGET-ABSORPTION","treatment_class":"institutional_county_only","constituency_default":"not_applicable","ward_default":"not_applicable"},
    {"indicator_id":"IND-COUNTY-BUDGET-TOTAL","treatment_class":"institutional_county_only","constituency_default":"not_applicable","ward_default":"not_applicable"},
    {"indicator_id":"IND-COUNTY-DEVELOPMENT-ABSORPTION","treatment_class":"institutional_county_only","constituency_default":"not_applicable","ward_default":"not_applicable"},
    {"indicator_id":"IND-COUNTY-EXPENDITURE-TOTAL","treatment_class":"institutional_county_only","constituency_default":"not_applicable","ward_default":"not_applicable"},
    {"indicator_id":"IND-COUNTY-OSR","treatment_class":"institutional_county_only","constituency_default":"not_applicable","ward_default":"not_applicable"},
    {"indicator_id":"IND-COUNTY-PENDING-BILLS","treatment_class":"institutional_county_only","constituency_default":"not_applicable","ward_default":"not_applicable"},
    {"indicator_id":"IND-DISABILITY-PREVALENCE","treatment_class":"survey_small_area"},
    {"indicator_id":"IND-ELECTRICITY-ACCESS","treatment_class":"survey_small_area","semantic_relationship":{"type":"alias_review","related_indicator":"IND-MAIN-GRID-ELECTRICITY"}},
    {"indicator_id":"IND-FGM-CHILD-MARRIAGE","treatment_class":"survey_small_area"},
    {"indicator_id":"IND-FUEL-PETROL","treatment_class":"dynamic_location_price"},
    {"indicator_id":"IND-GCP-CURRENT","treatment_class":"economic_accounts_small_area"},
    {"indicator_id":"IND-HEALTH-FACILITY-COUNT","treatment_class":"administrative_point_aggregate","semantic_constraint":"fixed 2023 Health Facility Census assessed universe"},
    {"indicator_id":"IND-HEALTH-FACILITY-DENSITY","treatment_class":"facility_service_rate"},
    {"indicator_id":"IND-HEALTH-FACILITY-STOCK","treatment_class":"administrative_point_aggregate","semantic_constraint":"current/live facility stock concept; do not substitute for dated 2023 census-assessed count"},
