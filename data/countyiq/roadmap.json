  "release_stages": [
    {
      "id": "A",
      "name": "Architecture complete",
      "definition": "Generated mart, schema, deterministic build and CI validation."
    },
    {
      "id": "B",
      "name": "Evidence breadth",
      "definition": ">=20 useful active county indicators across >=5 domains, including full fiscal history and matched denominator rules."
    },
    {
      "id": "C",
      "name": "Benchmark intelligence",
      "definition": "Versioned peers, matched trends, percentiles and auditable development-gap calculations."
    },
    {
      "id": "D",
      "name": "Composite research release",
      "definition": "County Development & Performance Index published only with sensitivity, robustness and historical validation."
    },
    {
      "id": "E",
      "name": "Accountability release",
      "definition": "County Government Delivery Score and administration context with attribution safeguards."
    },
    {
      "id": "F",
      "name": "Action layer",
      "definition": "Verified Opportunity Finder, Knowledge Hub and reproducible recognition."
    },
    {
      "id": "G",
      "name": "Mature CountyIQ",
      "definition": ">=30 robust indicators across all seven domains; complete drill-through, automated freshness/revisions and production validation."
    }
  ],
  "guardrails": [
    "No national statistic is inherited to a county, constituency or ward.",
    "No county value is pushed to a lower geography unless an explicit valid geographic method supports it.",
    "No production statistic is hardcoded in the CountyIQ UI.",
    "No composite score is published before methodology and robustness gates pass.",
    "No governor score equates broad county outcomes with personal causation.",
    "No live opportunity alert exists without a primary source and verification date.",
    "No missing county is silently imputed into a 47-county ranking.",
    "Survey estimates retain uncertainty requirements and ranking restrictions from the Atlas indicator registry.",
    "Every recognition is reproducible from a published rule.",
    "Every displayed metric keeps its own period, unit, source and provenance classification."
  ]
}
