{
  "product": {
    "name": "CountyIQ",
    "parent_product": "Kenya Data Atlas",
    "role": "Analytical and decision-intelligence layer over the canonical Atlas evidence layer",
    "target_state": "For every county, explain current conditions, performance, trend, peers, government delivery, gaps, opportunities and evidence with reproducible methodology.",
    "completion_definition": "All mature-product gates in docs/countyiq/GATES.md are met with evidence.",
    "current_release_stage": "scaffold",
    "target_release_stage": "mature"
  },
  "status_definitions": {
    "integrated": "Source-backed data already active in the Atlas and suitable for the stated CountyIQ use.",
    "ready_to_surface": "Data is already present in the Atlas but the CountyIQ experience has not yet exposed the full analytical use.",
    "sourced": "A credible primary/official source and indicator definition exist, but production observations or required metadata are not yet fully active.",
    "planned": "Desired final-product capability or indicator; source/ingestion/methodology work remains.",
    "research": "Methodology or modelling work required before publication as a normal production result.",
    "blocked": "Must not be published in the intended form until a specific evidence or validation gap is closed."
  },
  "final_experience": [
    {
      "id": "profile",
      "name": "County profile",
      "purpose": "Source-auditable county context across economy, people, services, infrastructure, public finance and institutions.",
      "status": "integrated",
      "target_features": [
        "headline facts",
        "domain navigation",
        "source drill-through",
        "historical context",
        "download/export"
      ]
    },
    {
      "id": "trend",
      "name": "Trend intelligence",
      "purpose": "Answer whether a county is improving using matched-period historical observations.",
      "status": "ready_to_surface",
      "target_features": [
        "latest",
        "one-period change",
        "3/5-year change",
        "national matched trend",
        "peer matched trend",
        "revision flags"
      ]
    },
    {
      "id": "peers",
      "name": "Peer benchmarking",
      "purpose": "Compare counties against structurally similar counties as well as the national distribution.",
      "status": "research",
      "target_features": [
        "versioned peer groups",
        "peer median",
        "peer rank",
        "national percentile",
        "distance to benchmark"
      ]
    },
    {
      "id": "performance_index",
      "name": "County Development & Performance Index",
      "purpose": "Transparent multi-domain composite of county outcomes and structural performance.",
      "status": "blocked",
      "blocker": "Insufficient validated domain breadth and no published sensitivity/back-testing package yet.",
      "target_features": [
        "overall score",
        "pillar scores",
        "rank",
        "percentile",
        "trend",
        "peer rank",
        "contribution breakdown",
        "robustness range"
      ]
    },
    {
      "id": "delivery_score",
      "name": "County Government Delivery & Accountability",
      "purpose": "Separate government-linked delivery and accountability from broad county outcomes.",
      "status": "planned",
      "target_features": [
        "fiscal execution",
        "OSR performance",
        "pending bills",
        "wage burden",
        "audit findings",
        "service delivery",
        "project evidence"
      ]
    },
    {
      "id": "administration_scorecards",
      "name": "Governor / administration scorecards",
      "purpose": "Show administration-period evidence without attributing all county outcomes to one political office-holder.",
      "status": "blocked",
      "blocker": "Delivery-layer breadth and defensible attribution rules must exist first.",
      "target_features": [
        "term baseline",
        "latest delivery metrics",
        "peer changes",
        "fiscal/accountability record",
        "attribution disclaimer"
      ]
    },
    {
      "id": "gap_calculator",
      "name": "Development Gap Calculator",
      "purpose": "Replace speculative opportunity-cost values with transparent benchmark counterfactuals.",
      "status": "planned",
      "target_features": [
        "formula disclosure",
        "peer/national benchmark",
        "explicit denominator",
        "period",
        "source",
        "non-causal wording"
      ]
    },
    {
      "id": "opportunity_finder",
      "name": "County Opportunity Finder",
      "purpose": "Match counties to verified programmes, grants, facilities and technical-assistance opportunities.",
      "status": "planned",
      "target_features": [
        "verified primary URL",
        "eligibility",
        "opening/deadline",
        "amount if official",
        "verification date",
        "match rationale"
      ]
    },
    {
      "id": "knowledge_hub",
      "name": "County Knowledge Hub",
      "purpose": "Provide the fastest path to county plans, budgets, audits, statistics and sector documents.",
      "status": "planned",
      "target_features": [
        "CIDP",
        "ADP",
        "CFSP",
        "CBROP",
        "budgets",
        "Controller of Budget",
        "Auditor-General",
        "statistical abstracts",
        "sector plans"
      ]
    },
    {
      "id": "recognition",
      "name": "Evidence-based recognition",
      "purpose": "Retain the motivational awards concept using reproducible CountyIQ rules rather than unofficial state honours.",
      "status": "planned",
      "target_features": [
        "most improved",
        "fiscal execution leader",
        "human development leader",
        "economic momentum",
        "peer-group leader",
        "data transparency"
      ]
    }
  ],
