    },
    "series_id": {
      "type": "string"
    },
    "geography_id": {
      "type": "string"
    },
    "period_start": {
      "type": "string"
    },
    "period_end": {
      "type": "string"
    },
    "period_label": {
      "type": "string"
    },
    "value": {
      "type": [
        "number",
        "null"
      ]
    },
    "source_dataset_id": {
      "type": "string"
    },
    "source_url": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "x-kda-contract-version": "1.0.0"
}
