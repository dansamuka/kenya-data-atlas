{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dansamuka.github.io/kenya-data-atlas/data/distribution/schemas/geography.schema.json",
  "title": "Kenya Data Atlas geography record",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "geography_id",
    "geo_code",
    "name",
    "level",
    "geography_system"
  ],
  "properties": {
    "geography_id": {
      "type": "string"
    },
    "geo_code": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "level": {
      "enum": [
        "country",
        "county",
        "constituency",
        "ward"
      ]
    },
    "geography_system": {
      "type": "string"
    }
  },
  "x-kda-contract-version": "1.0.0"
}
