{
  "name": "kenya-data-atlas",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "geography:build": "node scripts/geography/build-registry.mjs && node scripts/geography/ingest-boundaries.mjs && node --max-old-space-size=4096 scripts/geography/derive-parents.mjs",
    "geography:geometry": "node scripts/geography/ingest-boundaries.mjs",
    "geography:validate": "node scripts/geography/validate-registry.mjs",
    "catalogue:build": "node scripts/catalogue/build-catalogue.mjs",
    "catalogue:validate": "node scripts/catalogue/validate-catalogue.mjs",
    "build:data": "npm run geography:build && npm run catalogue:build && npm run indicators:build",
    "test": "npm run geography:validate && npm run catalogue:validate && npm run indicators:validate && npm run sprint1:validate && npm run sprint2:diagnose && npm run sprint2:validate",
    "geography:derive": "node --max-old-space-size=4096 scripts/geography/derive-parents.mjs",
    "geography:audit": "python3 scripts/geography/audit-geometry.py .",
    "indicators:compute-area": "node scripts/indicators/compute-derived-area.mjs",
    "indicators:build": "node scripts/indicators/compute-derived-area.mjs && node scripts/indicators/build-registry.mjs",
    "indicators:validate": "node scripts/indicators/validate-registry.mjs",
    "sprint1:validate": "node scripts/indicators/validate-sprint1.mjs",
    "sprint2:diagnose": "node scripts/indicators/diagnose-sprint2-geography.mjs",
    "sprint2:validate": "node scripts/indicators/validate-sprint2.mjs"
  },
  "dependencies": {
    "polygon-clipping": "^0.15.7"
  }
}
